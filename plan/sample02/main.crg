use std::fmt;
use std::vector::{Vec, vec};

fun main() {
    let input = fmt::readln().parse<u32>().unwrap_or(0u32);
    let mut v = vec();
    for i in 1..=input {
        v.push(i);
    }
    let mut result = 0u32;
    for item in v.iter() {
        result += item;
    }
    fmt::println("{}", result)    // result = input * (input + 1) / 2
}
