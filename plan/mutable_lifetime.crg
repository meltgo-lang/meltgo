package main;

using module;

import std::fmt; 
import plan::point::*;

mut struct Point<^a> {
    mut<^a> x: PointX<^a>,
    mut<^a> y: PointY<^a>,
}

impl<^a> Point<^a> {
    pub fun new() init {
        x: PointX::new(0f64),
        y: PointY::new(0f64),
    }

    pub fun from(x: f64, y: f64) init {
        x: PointX::new(x),
        y: PointY::new(y),
    }
}

fun main() {
    let mut p = Point::from(10f64, 20f64);
    let p_xmb = &mut p.x;
    // error: let p_ymb = &mut p.y;
}
